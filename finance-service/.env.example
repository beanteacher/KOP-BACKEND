# finance-service 로컬 개발용 환경변수 템플릿.
# 실제 값은 이 파일을 finance-service/.env 로 복사해서 채운다 — .env는 gitignore 처리되어
# 커밋되지 않는다. 값이 비어 있으면 application.yml의 로컬 기본값이 쓰인다.

# developers.openbanking.or.kr 테스트베드에서 발급받은 값
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=

# 기본값을 바꿀 때만 채운다(보통 안 건드려도 됨)
# OPENBANKING_BASE_URL=https://testapi.openbanking.or.kr
# OPENBANKING_REDIRECT_URI=http://localhost:5173/settings/bank-account/callback

# 실제 거래내역조회 API를 쓰려면 real로 바꾼다(기본은 mock — 항상 빈 목록).
# institution-code는 Client ID와 다른 값 — 개발자센터에서 별도 확인하는 10자리 이용기관코드.
# OPENBANKING_GATEWAY_PROVIDER=real
# OPENBANKING_INSTITUTION_CODE=
